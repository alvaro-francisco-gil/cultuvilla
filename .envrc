# Cultuvilla dev service account, scoped to this project.
#
# This used to live in ~/.bashrc as a global export, which meant every OTHER
# project's Google admin SDK silently authenticated as cultuvilla — Órdago's
# backfill tooling failed with `Missing or insufficient permissions`, which
# reads as a Firestore rules problem rather than an auth one.
#
# direnv is hooked in ~/.bashrc; run `direnv allow` here once after cloning.
export GOOGLE_APPLICATION_CREDENTIALS="$HOME/.config/cultuvilla/dev-sa.json"
